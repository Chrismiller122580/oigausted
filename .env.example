# Oiga Usted - Environment Variables
# Copy this file to .env.local (or .env) and fill in the values.

# =============================================================================
# DATABASE
# - Local dev: SQLite is fine (file:./dev.db) - handled automatically by dev scripts
# - Production (Vercel): Use PostgreSQL (Vercel Postgres, Neon, Supabase, Prisma, etc.)
#   Example: postgresql://user:pass@host:5432/db?sslmode=require
# 
# IMPORTANT for migrations during build:
# - Set DATABASE_URL to your (pooled) connection string for the app runtime.
# - Set DIRECT_DATABASE_URL to a direct (non-pooled) connection string.
#   This is required for `prisma migrate deploy` to work during Vercel builds.
#   (Prisma Postgres / db.prisma.io provides separate direct and pooled URLs.)
# =============================================================================
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://..."
# DIRECT_DATABASE_URL="postgresql://..."  # direct connection for migrations (set in Vercel for build)

# =============================================================================
# NEXTAUTH (Required)
# =============================================================================
NEXTAUTH_SECRET="your-super-secret-random-string-here-at-least-32-chars"

# NEXTAUTH_URL
# - Local development: usually "http://localhost:3000"
# - Codespaces / remote dev: Set to your current Codespaces URL (e.g. https://xxx-3000.app.github.dev)
#   You can override at runtime: NEXTAUTH_URL=https://your-codespace-url npm run dev
# - Vercel: Set the correct production/preview URL (or your custom domain)
#
# IMPORTANT: When using `vercel env pull`, you may inherit old/stale values.
# It is often safer to manage NEXTAUTH_URL via command line or .env.local in dev.
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# GOOGLE OAUTH (Optional but recommended for real testing)
# Get these from https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# WOMPI PAYMENTS
# - Development: Use Sandbox keys (see https://docs.wompi.co/en/docs/sandbox)
# - Production: You MUST switch to Live keys
# =============================================================================
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_INTEGRITY_KEY="test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_KEY="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# OPTIONAL / FUTURE
# =============================================================================
# NEXT_PUBLIC_APP_URL="https://oigagig.com"

# =============================================================================
# GOOGLE OAUTH (for "Continue with Google")
# =============================================================================
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
#
# Optional: Comma-separated list of Gmail addresses that should
# automatically get admin role when they sign in with Google.
# ADMIN_EMAILS="oigaustedcolombia@gmail.com"

# =============================================================================
# GOOGLE MAPS (Geolocation & Maps features)
# =============================================================================
# Get your key here: https://console.cloud.google.com/apis/credentials
# Enable these APIs: Maps JavaScript API + Places API + Geocoding API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."

# =============================================================================
# RESEND (Email - Recommended)
# Get your API key at https://resend.com/api-keys
# =============================================================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="OigaUsted <support@oigagig.com>"

# CRON_SECRET (used by /api/notifications/digest to authorize Vercel crons or manual admin calls)
# Generate a strong one: openssl rand -base64 32
# In Vercel, set this for Production (and use in vercel.json cron headers if needed).
CRON_SECRET=""

# =============================================================================
# VERCEL PRODUCTION NOTES
# =============================================================================
# 1. Set all the above vars in Vercel Dashboard (Production + Preview)
# 2. Add your production domain to Google OAuth "Authorized redirect URIs"
#    https://oigagig.com/api/auth/callback/google
# 3. For Wompi: Use live (not test) keys in production
# 4. Run `prisma migrate deploy` automatically via the build command (already configured)
# 5. Use Vercel Postgres or external Postgres for DATABASE_URL
# 6. After first deploy, create an admin user with: 
#    DATABASE_URL="..." npm run create-admin admin@oigagig.co.com YourStrongPassword123!
