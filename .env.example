# Oiga Usted - Environment Variables
# Copy this file to .env.local (or .env) and fill in the values.

# =============================================================================
# DATABASE
# - Local dev: SQLite is fine (file:./dev.db) - handled automatically by dev scripts
# - Production (Vercel): PostgreSQL required. The app is configured for Prisma Data Platform
#   (db.prisma.io) or any standard Postgres (Neon, Supabase, Vercel Postgres, etc.).
#
# For Prisma Data Platform / db.prisma.io (the current hosting for oigagig.com):
#   1. In Prisma Console → your project → "Connection strings"
#   2. Use the **Accelerate** connection string as DATABASE_URL.
#      It starts with: prisma+postgres://accelerate.prisma-data.net/...
#   3. This is MANDATORY for serverless (Vercel). The plain postgresql:// direct URL
#      will produce exactly: "Can't reach database server at `db.prisma.io:5432`"
#   4. For migrations during build, use the "Direct connection" / migration string
#      as DIRECT_DATABASE_URL (the one with the low-limit "prisma_migration" role).
#
# CRITICAL (serverless / Vercel):
# - DATABASE_URL must be the Accelerate (prisma+postgres://) or properly pooled URL.
# - Never use a migration/direct connection string as DATABASE_URL at runtime.
# - DIRECT_DATABASE_URL = direct string, used **only** by ./scripts/prisma-safe-migrate.sh
#   during `prisma migrate deploy` in Vercel builds.
# =============================================================================
DATABASE_URL="file:./dev.db"
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/..."   # <-- Prisma Accelerate (prod)
# DIRECT_DATABASE_URL="postgresql://..."                            # direct for migrations only

# =============================================================================
# NEXTAUTH (Required)
# =============================================================================
NEXTAUTH_SECRET="your-super-secret-random-string-here-at-least-32-chars"

# NEXTAUTH_URL
# - Local development: usually "http://localhost:3000"
# - Codespaces / remote dev: Set to your current Codespaces URL (e.g. https://xxx-3000.app.github.dev)
#   You can override at runtime: NEXTAUTH_URL=https://your-codespace-url npm run dev
# - Vercel: Set the correct production/preview URL (or your custom domain)
#
# IMPORTANT: When using `vercel env pull`, you may inherit old/stale values.
# It is often safer to manage NEXTAUTH_URL via command line or .env.local in dev.
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# GOOGLE OAUTH (Optional but recommended for real testing)
# Get these from https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# WOMPI PAYMENTS (Colombia)
# Get keys from https://comercios.wompi.co → Desarrolladores
#
# Required variables:
#   NEXT_PUBLIC_WOMPI_PUBLIC_KEY   → pub_prod_... or pub_test_...
#   WOMPI_INTEGRITY_KEY            → prod_integrity_... or test_integrity_...
#   WOMPI_EVENTS_KEY               → prod_events_... or test_events_...
#
# The private key (prv_...) is only needed if you later switch to full API mode.
# Note: The code also supports the legacy name WOMPI_INTEGRITY_SECRET as fallback.

# Wompi SFTP/FTPS (optional, for reports & settlements)
# Get details from Wompi dashboard → Developers → Integrations → SFTP/FTPS
# WOMPI_SFTP_ENABLED=true
# WOMPI_SFTP_HOST=sftp.example.wompi.co
# WOMPI_SFTP_PORT=22
# WOMPI_SFTP_USERNAME=youruser
# WOMPI_SFTP_PASSWORD=...
# or
# WOMPI_SFTP_PRIVATE_KEY="-----BEGIN ...-----"
# WOMPI_SFTP_REMOTE_PATH=/reports

#
# After changing these in production, redeploy.
# =============================================================================
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_INTEGRITY_KEY="test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_KEY="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# OPTIONAL / FUTURE
# =============================================================================
# NEXT_PUBLIC_APP_URL="https://oigagig.com"

# =============================================================================
# GOOGLE OAUTH (for "Continue with Google")
# =============================================================================
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
#
# Optional: Comma-separated list of Gmail addresses that should
# automatically get admin role when they sign in with Google.
# ADMIN_EMAILS="oigaustedcolombia@gmail.com"

# =============================================================================
# GOOGLE MAPS (Geolocation & Maps features)
# =============================================================================
# Get your key here: https://console.cloud.google.com/apis/credentials
# Enable these APIs: Maps JavaScript API + Places API + Geocoding API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."

# =============================================================================
# RESEND (Email - Recommended)
# Get your API key at https://resend.com/api-keys
# =============================================================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="OigaUsted <support@support.oigagig.com>"

# RESEND_WEBHOOK_SECRET (Svix) — required for /api/webhooks/resend to verify inbound delivery events.
# Get it from your Resend dashboard (Webhooks section). If unset, delivery events are ignored (fail-closed).
# RESEND_WEBHOOK_SECRET="re_..."

# CRON_SECRET (used by /api/notifications/digest to authorize Vercel crons or manual admin calls)
# Generate a strong one: openssl rand -base64 32
# In Vercel, set this for Production (and use in vercel.json cron headers if needed).
CRON_SECRET=""

# =============================================================================
# VERCEL PRODUCTION NOTES
# =============================================================================
# 1. Set all the above vars in Vercel Dashboard (Production + Preview)
# 2. Add your production domain to Google OAuth "Authorized redirect URIs"
#    https://oigagig.com/api/auth/callback/google
# 3. For Wompi: Use live (not test) keys in production
# 4. Run `prisma migrate deploy` automatically via the build command (already configured)
# 5. Use Vercel Postgres or external Postgres for DATABASE_URL
# 6. After first deploy, create an admin user with: 
#    DATABASE_URL="..." npm run create-admin admin@oigagig.co.com YourStrongPassword123!
