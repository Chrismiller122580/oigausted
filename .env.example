# Oigagig - Environment Variables
# Copy this file to .env.local (or .env) and fill in the values.

# =============================================================================
# DATABASE
# - Local dev: SQLite is fine (file:./dev.db) - handled automatically by dev scripts
# - Production (Vercel): PostgreSQL required. The app is configured for Prisma Data Platform
#   (db.prisma.io) or any standard Postgres (Neon, Supabase, Vercel Postgres, etc.).
#
# For Prisma Data Platform / db.prisma.io (the current hosting for oigagig.com):
#   1. In Prisma Console → your project → "Connection strings"
#   2. Use the **Accelerate** connection string (starts with prisma+postgres://...) as DATABASE_URL.
#      This is the pooled one required for serverless (Vercel).
#   3. Use the plain "Direct connection" string (the one you have that starts with postgres://
#      and contains the long hash + sk_... secret) ONLY as DIRECT_DATABASE_URL.
#
#   Example of what you should set in Vercel:
#     DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=...
#     DIRECT_DATABASE_URL=postgres://c01be402929664490f2ff0e9cabe4311d2dd543a55bb13450e581ef8aa8ce47f:sk_s9aLo0usjHD9QkMiH-W72@db.prisma.io:5432/postgres?sslmode=require
#
#   CRITICAL: Using the direct postgres:// string as DATABASE_URL causes
#   "Too many database connections opened: FATAL: too many connections for role \"prisma_migration\""
#   because that role has a very low connection limit. Serverless functions open many short-lived connections.
#
# CRITICAL (serverless / Vercel):
# - DATABASE_URL must be the Accelerate (prisma+postgres://) or properly pooled URL.
# - Never use a migration/direct connection string as DATABASE_URL at runtime.
# - DIRECT_DATABASE_URL = direct string, used **only** by ./scripts/prisma-safe-migrate.sh
#   during `prisma migrate deploy` in Vercel builds.
# =============================================================================
DATABASE_URL="file:./dev.db"
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..DqHzf0wZtA5STsPNNi4NyqVwiHFh6fpXjXQqUr5ROEY"   # CORRECT Accelerate pooled URL for production (use this as DATABASE_URL)
# DIRECT_DATABASE_URL="postgres://c01be402929664490f2ff0e9cabe4311d2dd543a55bb13450e581ef8aa8ce47f:sk_s9aLo0usjHD9QkMiH-W72@db.prisma.io:5432/postgres?sslmode=require"  # direct string for migrations only

# These two are sometimes auto-created by Vercel or other tools.
# Do NOT use the direct postgres:// string for DATABASE_URL at runtime.
# POSTGRES_URL=...
# PRISMA_DATABASE_URL=...

# =============================================================================
# NEXTAUTH (Required)
# =============================================================================
NEXTAUTH_SECRET="your-super-secret-random-string-here-at-least-32-chars"

# NEXTAUTH_URL
# - Local development: usually "http://localhost:3000"
# - Codespaces / remote dev: Set to your current Codespaces URL (e.g. https://xxx-3000.app.github.dev)
#   You can override at runtime: NEXTAUTH_URL=https://your-codespace-url npm run dev
# - Vercel: Set the correct production/preview URL (or your custom domain)
#
# IMPORTANT: When using `vercel env pull`, you may inherit old/stale values.
# It is often safer to manage NEXTAUTH_URL via command line or .env.local in dev.
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# GOOGLE OAUTH (Optional but recommended for real testing)
# Get these from https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# WOMPI PAYMENTS (Colombia)
# Get keys from https://comercios.wompi.co → Desarrolladores → Secretos de integración técnica
#
# Required variables:
#   NEXT_PUBLIC_WOMPI_PUBLIC_KEY   → pub_prod_... or pub_test_...
#   WOMPI_INTEGRITY_KEY            → prod_integrity_... or test_integrity_...   ← Llave de integridad (for widget signature)
#   WOMPI_EVENTS_KEY               → prod_events_... or test_events_...         ← Llave para eventos (for webhooks)
#   CRITICAL: After setting, use Admin → Settings → Wompi Tester with a *real* event JSON from Wompi
#   (paste the full {"data":{...},"event":"transaction.updated","signature":{...},"timestamp":...})
#   + the candidate key as "testEventsKey" until "matches: true".
#   Only then set in Vercel (Production + Preview) and redeploy. Dummy samples always pass.
#   Real events from your pub key are the only proof the key is correct.
#   WOMPI_PRIVATE_KEY              → prv_prod_... or prv_test_...               ← For /api/orders/.../check-wompi (recommended)
#
# This project uses (example):
#   NEXT_PUBLIC_WOMPI_PUBLIC_KEY = pub_prod_SZdbUpSGERKCIGAcJOaIax7ySu4w9tAN
# The other three secrets must be the exact matching ones from the Wompi dashboard
# for THIS public key (under Secretos de integración técnica for that commerce).
# IMPORTANT: The EVENTS_KEY value must be the one that makes real webhook events
# pass signature validation. Use Admin → Wompi tester with a real "Evento" JSON
# as sampleEvent to verify before setting in Vercel. After changing, redeploy.
#
# For local dev, the example below uses test_ keys. For production, replace with your prod_ keys from Wompi dashboard.
#
# Note: The code also supports the legacy name WOMPI_INTEGRITY_SECRET as fallback.
# After changing these in Vercel, redeploy. The server logs will now print the loaded key prefixes.

# Wompi SFTP/FTPS (optional, for reports & settlements)
# Get details from Wompi dashboard → Developers → Integrations → SFTP/FTPS
# WOMPI_SFTP_ENABLED=true
# WOMPI_SFTP_HOST=sftp.example.wompi.co
# WOMPI_SFTP_PORT=22
# WOMPI_SFTP_USERNAME=youruser
# WOMPI_SFTP_PASSWORD=...
# or
# WOMPI_SFTP_PRIVATE_KEY="-----BEGIN ...-----"
# WOMPI_SFTP_REMOTE_PATH=/reports

#
# After changing these in production, redeploy.
# =============================================================================
# Exact keys for CORTLAND BLACKSTONE S.A.S. (pub_prod_SZdbUpSGERKCIGAcJOaIax7ySu4w9tAN)
# Copy the three secrets from https://comercios.wompi.co for this exact public key
# (Secretos de integración técnica → Eventos / Integridad / Privada for this commerce).
# IMPORTANT: The EVENTS_KEY value must be validated against *real* events using the admin tester
# form on /admin/settings (paste full Evento JSON as sampleEvent + candidate as testEventsKey)
# until it reports matches:true for actual Wompi checksums. The basic "sample sig OK" only tests dummy data.
# After finding the correct one, set in Vercel Production exactly and redeploy.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_prod_SZdbUpSGERKCIGAcJOaIax7ySu4w9tAN"
WOMPI_INTEGRITY_KEY="prod_integrity_fNEJZiWprHYzRtzY9JG1qVH4ZcaKsskc"
WOMPI_EVENTS_KEY="prod_events_jxa0Bz1S7uHmr1Nc3g4wL4u4i0DySop"  # This was the value tested in admin tester for the DECLINED event below; it did NOT match the real checksum from Wompi. Get the exact current one from Wompi dashboard for your pub_prod_SZd... and test in admin tester until matches=true.
WOMPI_PRIVATE_KEY="prv_prod_2hEcDnQqS0bEcpuHI9gTnGbTd2tuJ8Z1"

# =============================================================================
# MAINTENANCE & DEV SAFETY
# =============================================================================
# Comma-separated IPs that bypass maintenance mode (merged with Admin → Settings list)
# MAINTENANCE_BYPASS_IPS="203.0.113.10"
#
# When true, treat config fetch failures as maintenance active (fail-closed)
# MAINTENANCE_FAIL_CLOSED="false"
#
# Allow simulating Wompi Paid status without webhook (local dev only by default)
# ALLOW_DEV_PAYMENT_SIMULATE="true"
# NEXT_PUBLIC_ALLOW_DEV_PAYMENT_SIMULATE="true"   # shows dev button in checkout UI
#
# Allow Wompi webhook signature fallback during key setup (non-production only)
# WOMPI_ALLOW_SIGNATURE_FALLBACK="true"

# =============================================================================
# OPTIONAL / FUTURE
# =============================================================================
# NEXT_PUBLIC_APP_URL="https://oigagig.com"

# =============================================================================
# GOOGLE OAUTH (for "Continue with Google")
# =============================================================================
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
#
# Optional: Comma-separated list of Gmail addresses that should
# automatically get admin role when they sign in with Google.
# ADMIN_EMAILS="oigaustedcolombia@gmail.com"

# =============================================================================
# GOOGLE MAPS (Geolocation & Maps features)
# =============================================================================
# Get your key here: https://console.cloud.google.com/apis/credentials
# Enable these APIs: Maps JavaScript API + Places API + Geocoding API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."

# =============================================================================
# RESEND (Email - Recommended)
# Get your API key at https://resend.com/api-keys
#
# RESEND_API_KEY     → API key only (starts with re_)
# RESEND_FROM_EMAIL  → Sender address, NOT an API key. Example:
#                      Oigagig <support@oigagig.com>
# Domain must be verified in Resend before using @oigagig.com.
# For quick tests only: Oigagig <onboarding@resend.dev>
# =============================================================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Oigagig <support@oigagig.com>"

# RESEND_WEBHOOK_SECRET (Svix) — required for /api/webhooks/resend to verify inbound delivery events.
# Get it from your Resend dashboard (Webhooks section). If unset, delivery events are ignored (fail-closed).
# RESEND_WEBHOOK_SECRET="re_..."

# CRON_SECRET (used by /api/notifications/digest to authorize Vercel crons or manual admin calls)
# Generate a strong one: openssl rand -base64 32
# In Vercel, set this for Production (and use in vercel.json cron headers if needed).
CRON_SECRET=""

# =============================================================================
# VERCEL PRODUCTION NOTES
# =============================================================================
# 1. Set all the above vars in Vercel Dashboard (Production + Preview)
# 2. Add your production domain to Google OAuth "Authorized redirect URIs"
#    https://oigagig.com/api/auth/callback/google
# 3. For Wompi: Use live (not test) keys in production
# 4. Run `prisma migrate deploy` automatically via the build command (already configured)
# 5. Use Vercel Postgres or external Postgres for DATABASE_URL
# 6. After first deploy, create an admin user with: 
#    DATABASE_URL="..." npm run create-admin admin@oigagig.com YourStrongPassword123!
