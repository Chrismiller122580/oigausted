generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  name            String?
  email           String?  @unique
  role            String   @default("buyer")
  phone           String?
  idNumber        String?
  address         String?
  instagram       String?
  facebook        String?
  whatsapp        String?
  businessName    String?
  nit             String?
  bio             String?
  tagline         String?
  city            String?
  profilePicture  String?
  rating          Float?   @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gigs            Gig[]
  ordersAsBuyer   Order[]  @relation("BuyerOrders")
  ordersAsSeller  Order[]  @relation("SellerOrders")
  password        String?
  reviewsReceived Review[] @relation("ReviewToSeller")
  reviewsGiven    Review[] @relation("ReviewToBuyer")
  accounts        Account[]
  sessions        Session[]
}

model Gig {
  id            String   @id @default(uuid())
  title         String
  description   String?
  price         Float
  category      String?
  completionTime String?
  imageUrl      String?
  fields        Json?
  addons        Json?
  createdAt     DateTime @default(now())
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id])
  orders        Order[]
}

model Order {
  id              String      @id @default(uuid())
  price           Float
  status          String      @default("Pending")
  progress        Int         @default(0)
  trackingNumber  String?
  buyerId         String
  sellerId        String
  gigId           String?
  createdAt       DateTime    @default(now())
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User        @relation("SellerOrders", fields: [sellerId], references: [id])
  gig             Gig?        @relation(fields: [gigId], references: [id])
  files           OrderFile[]
  messages        OrderMessage[]
}

model OrderFile {
  id          String   @id @default(uuid())
  name        String
  url         String
  size        Int
  type        String
  uploadedBy  String
  orderId     String
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
}

model OrderMessage {
  id          String   @id @default(uuid())
  content     String
  senderId    String
  senderRole  String
  isFromBuyer Boolean
  orderId     String
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  sellerId  String
  buyerId   String
  seller    User     @relation("ReviewToSeller", fields: [sellerId], references: [id])
  buyer     User     @relation("ReviewToBuyer", fields: [buyerId], references: [id])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
