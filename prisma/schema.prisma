generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  name            String?
  email           String?  @unique
  role            String   @default("buyer")
  phone           String?
  idNumber        String?
  address         String?
  instagram       String?
  facebook        String?
  whatsapp        String?
  businessName    String?
  nit             String?
  bio             String?
  profilePicture  String?
  rating          Float?   @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gigs            Gig[]
  ordersAsBuyer   Order[]  @relation("BuyerOrders")
  ordersAsSeller  Order[]  @relation("SellerOrders")
  password        String?
  reviewsReceived Review[] @relation("ReviewToSeller")
  reviewsGiven    Review[] @relation("ReviewToBuyer")
}

model Gig {
  id              String   @id @default(uuid())
  title           String
  description     String?
  price           Float
  category        String?
  completionTime  String?
  imageUrl        String?
  fields          Json?
  addons          Json?
  createdAt       DateTime @default(now())

  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])

  orders          Order[]
}

model Order {
  id              String   @id @default(uuid())
  price           Float
  status          String   @default("Pending") // Pending, InProgress, Completed, Cancelled
  progress        Int      @default(0)         // 0-100
  trackingNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyerId         String
  sellerId        String
  gigId           String

  buyer           User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User     @relation("SellerOrders", fields: [sellerId], references: [id])
  gig             Gig      @relation(fields: [gigId], references: [id])

  messages        OrderMessage[]
  files           OrderFile[]
  reviews         Review[]
}

model OrderMessage {
  id        String   @id @default(uuid())
  content   String
  isFromBuyer Boolean
  createdAt DateTime @default(now())

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
}

model OrderFile {
  id          String   @id @default(uuid())
  fileUrl     String
  fileName    String
  uploadedByBuyer Boolean
  createdAt   DateTime @default(now())

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id          String   @id @default(uuid())
  rating      Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  reviewerId  String
  sellerId    String
  orderId     String

  reviewer    User     @relation("ReviewToBuyer", fields: [reviewerId], references: [id])
  seller      User     @relation("ReviewToSeller", fields: [sellerId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
}
