generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use PostgreSQL for production (Vercel, Supabase, Neon, etc.)
  // For local development you can temporarily switch to SQLite:
  // provider = "sqlite"
  // url      = "file:./dev.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
