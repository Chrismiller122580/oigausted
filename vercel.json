{
  "headers": [
    {
      "source": "/meta.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ],
  "buildCommand": "prisma generate --no-engine && ./scripts/prisma-safe-migrate.sh && node scripts/chromium-pack.mjs && node scripts/copy-playwright-browsers.mjs && next build --webpack",
  "functions": {
    "src/app/api/admin/userlens/scan/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "src/app/api/admin/marketing/seller-toolkit-blast/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/notifications/digest?frequency=daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/notifications/digest?frequency=weekly",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/notifications/lifecycle",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/admin/marketing/seller-toolkit-blast",
      "schedule": "0 20 6 7 *"
    },
    {
      "path": "/api/admin/marketing/seller-toolkit-blast",
      "schedule": "10 20 6 7 *"
    },
    {
      "path": "/api/admin/marketing/seller-toolkit-blast",
      "schedule": "20 20 6 7 *"
    },
    {
      "path": "/api/admin/marketing/seller-toolkit-blast",
      "schedule": "0 21 6 7 *"
    },
    {
      "path": "/api/admin/marketing/seller-toolkit-blast",
      "schedule": "30 21 6 7 *"
    }
  ]
}
