{
  "buildCommand": "prisma generate --no-engine && ./scripts/prisma-safe-migrate.sh && node scripts/chromium-pack.mjs && next build --webpack",
  "functions": {
    "src/app/api/admin/userlens/scan/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/notifications/digest?frequency=daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/notifications/digest?frequency=weekly",
      "schedule": "0 8 * * 1"
    }
  ]
}
